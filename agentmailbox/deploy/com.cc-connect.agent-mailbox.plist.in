<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cc-connect.agent-mailbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PREFIX@/agent-mailbox</string>
    <string>serve</string>
    <string>--runtime</string>
    <string>@RUNTIME@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>@RUNTIME@/service.stdout.log</string>
  <key>StandardErrorPath</key><string>@RUNTIME@/service.stderr.log</string>
</dict>
</plist>
